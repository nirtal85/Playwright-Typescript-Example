{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"automerge": true,
	"automergeType": "pr",
	"extends": [
		"config:recommended",
		"group:all",
		"customManagers:biomeVersions"
	],
	"pre-commit": {
		"enabled": true
	},
	"dependencyDashboard": true,
	"internalChecksFilter": "strict",
	"prCreation": "not-pending",
	"packageRules": [
		{
			"matchDatasources": ["npm"],
			"minimumReleaseAge": "2 days"
		}
	],
	"schedule": ["monthly"]
}
